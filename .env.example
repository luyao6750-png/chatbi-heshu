# 复制本文件为 .env 并填写实际值

# 应用
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL（填你本地 PostgreSQL 的连接信息；默认使用独立的 chatbi_db 库）
DB_HOST=localhost
DB_PORT=5432
DB_USER=medical
DB_PASSWORD=medical123
DB_NAME=chatbi_db

# LLM（兼容 OpenAI 协议，默认走阿里 DashScope 兼容模式）
DASHSCOPE_API_KEY=
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max

# 日志
LOG_LEVEL=DEBUG
